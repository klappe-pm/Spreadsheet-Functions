{
  "version": 1,
  "heredoc_receivers": ["railway"],
  "commands": {
    "railway": {
      "value_options": ["-s", "--service", "-e", "--environment", "-p", "--project"],
      "prints": [
        {
          "subcommands": ["variables", "variable", "vars"],
          "label": "railway variables (prints values)",
          "unless_flags": ["--help", "-h"],
          "unless_operand": ["set"]
        }
      ],
      "runs": [
        {
          "subcommands": ["ssh", "run", "shell"],
          "operands_without_dashes": ["run"]
        }
      ]
    }
  },
  "fallback": [
    {
      "label": "railway variables",
      "pattern": "\\brailway\\b[^\\n;|&]*\\s(variables|variable|vars)(\\s|$)"
    }
  ]
}
